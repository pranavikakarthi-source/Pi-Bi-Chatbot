{
  "name": "chatbot",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:start": "concurrently -k \"npm run start\" \"wait-on http://localhost:3000 && electron .\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "wait-on": "^9.5.1"
  }
}
